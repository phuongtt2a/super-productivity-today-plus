{
  "id": "sp-today-tasks-habits",
  "name": "Today+",
  "version": "1.1.1-beta.1",
  "description": "Today+ brings tasks due today and scheduled habits into one calm view, with subtasks and optional overdue and finished tasks.",
  "manifestVersion": 1,
  "minSupVersion": "14.0.0",
  "author": "phuongtt2a",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": false,
  "permissions": [
    "getTasks",
    "getAllProjects",
    "getAllSimpleCounters",
    "updateTask",
    "setCounter",
    "selectTask"
  ],
  "hooks": [
    "taskCreated",
    "taskUpdate",
    "taskComplete",
    "taskDelete"
  ]
}
