{
  "id": "sp-today-tasks-habits",
  "name": "Today+",
  "version": "2.0.0",
  "description": "Today+ combines today's tasks and habits with personal ordering, Working Now, native time tracking, and Focus mode.",
  "manifestVersion": 1,
  "minSupVersion": "14.0.0",
  "author": "phuongtt2a",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": false,
  "permissions": [
    "getTasks",
    "getAllProjects",
    "getAllSimpleCounters",
    "updateTask",
    "setCounter",
    "selectTask",
    "loadSyncedData",
    "persistDataSynced",
    "startTracking",
    "stopTracking",
    "dispatchAction",
    "getDayContext"
  ],
  "hooks": [
    "taskCreated",
    "taskUpdate",
    "taskComplete",
    "taskDelete",
    "currentTaskChange",
    "dataChanged",
    "dayChange",
    "persistedDataChanged"
  ]
}
